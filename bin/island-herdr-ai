#!/bin/bash
# island:summary=Ad-hoc herdr layout assistant — describe a change, Claude proposes the herdr commands, you approve.
# island:args=[request words...]
#
# Bound to prefix+a in herdr (a temporary pane, [[keys.command]] type="pane"). Ask for
# a layout change in plain language ("give the bid-desk agent its own space", "put all
# studio agents in one tab"). It hands the live layout plus a herdr cheat-sheet to
# Claude (headless, your subscription), which proposes the exact `herdr` commands. You
# see them and confirm before anything runs — and only `herdr ...` lines are ever run.
#
# v1 works on named targets from the layout; "this space/pane" is ambiguous from a
# popup pane. ISLAND_HERDR_AI_MODEL overrides the model (default: your usual model).

set -eEo pipefail

command -v herdr >/dev/null 2>&1 || { echo "island-herdr-ai: herdr not on PATH" >&2; exit 1; }
command -v claude >/dev/null 2>&1 || { echo "island-herdr-ai: claude not on PATH" >&2; exit 1; }

# Keep the pane open at the end so its output is readable before herdr closes it.
pause() { read -r -p $'\nPress Enter to close… ' _ || true; }

request="$*"
if [[ -z "$request" ]]; then
  read -r -p "What layout change? " request || true
fi
[[ -n "$request" ]] || { echo "Nothing asked."; pause; exit 0; }

# Live layout for Claude to reason over.
layout=$(
  printf 'WORKSPACES:\n%s\nTABS:\n%s\nAGENTS:\n%s\n' \
    "$(herdr workspace list 2>/dev/null)" \
    "$(herdr tab list 2>/dev/null)" \
    "$(herdr agent list 2>/dev/null)"
)

read -r -d '' cheat <<'EOF' || true
herdr CLI (targets: workspace_id like w7, tab_id like w7:t3, pane_id like w7:p9):
  herdr workspace create --label TEXT [--cwd PATH] [--no-focus]
  herdr workspace rename <workspace_id> <label>
  herdr workspace focus <workspace_id>
  herdr workspace close <workspace_id>
  herdr pane move <pane_id> --new-workspace [--label TEXT] [--no-focus]
  herdr pane move <pane_id> --new-tab [--workspace ID] [--label TEXT] [--no-focus]
  herdr pane move <pane_id> --tab <tab_id> --split right|down [--no-focus]
  herdr pane rename <pane_id> <label> | --clear
  herdr pane focus --direction left|right|up|down
  herdr agent rename <target> <name> | --clear
  herdr agent focus <target>
EOF

prompt="You translate a layout request into herdr CLI commands.
$cheat

Current layout:
$layout

Request: $request

Rules: address an agent or pane by its pane_id (e.g. w7:p9) from the AGENTS list —
never by workspace_id. Use workspace_id (e.g. w7) only for `herdr workspace` commands.
Output ONLY the herdr commands to run, one per line, in order, no markdown, no prose.
If the request is impossible or unclear, output a single line starting with '# ' that says why."

model_flag=()
[[ -n "${ISLAND_HERDR_AI_MODEL:-}" ]] && model_flag=(--model "$ISLAND_HERDR_AI_MODEL")

echo "Thinking…"
# stdin from /dev/null: claude -p would otherwise swallow the terminal input we need
# for the y/N confirm below (it reads stdin when stdin is not the prompt source).
plan=$(claude -p "${model_flag[@]}" "$prompt" </dev/null 2>/dev/null || true)
[[ -n "$plan" ]] || { echo "No response from Claude."; pause; exit 1; }

echo
echo "Proposed:"
echo "-----------------------------------------"
printf '%s\n' "$plan"
echo "-----------------------------------------"

# Only lines that are actual `herdr ...` commands are runnable; comments (# …) and any
# stray non-herdr line are shown but never executed. (Plain read loop — macOS ships
# Bash 3.2, which has no mapfile.)
runnable=()
while IFS= read -r line; do
  [[ -n "$line" ]] && runnable+=("$line")
done < <(printf '%s\n' "$plan" | grep -E '^[[:space:]]*herdr[[:space:]]' || true)
if (( ${#runnable[@]} == 0 )); then
  echo $'\n(nothing runnable — see notes above)'
  pause
  exit 0
fi

read -r -p $'\nRun these? [y/N] ' ans || true
if [[ "$ans" != "y" && "$ans" != "Y" ]]; then
  echo "Aborted — nothing changed."
  pause
  exit 0
fi

echo
for line in "${runnable[@]}"; do
  echo "\$ $line"
  if eval "$line"; then :; else echo "  ↳ failed" >&2; fi
done

echo $'\nDone.'
pause
