#!/bin/bash
# island:summary=Run the current worktree's ./ai.sh (Claude Code), tinted with its branch color.
# island:args=[claude args...]
#
# Finds ai.sh at or above $PWD and runs it from that directory, so the agent's cwd
# is the worktree root. Outside a checkout that ships one — another repo, a plain
# directory — it runs claude itself the way ai.sh would, from the repository root.
# Without an explicit --name/-n it names the session after the branch — that sets
# claude's terminal title, and (under herdr) the agent-panel label too.
#
# The pane is tinted with the worktree's branch color (OSC 11) for as long as the
# agent runs — dimmed to a background the text still reads on, the way the Web
# Agent tints its terminal. ISLAND_AI_KEEP_COLOR=1 leaves the tint behind on exit.

set -eEo pipefail

root="$PWD"
while [[ "$root" != "/" && ! -f "$root/ai.sh" ]]; do
  root=$(dirname "$root")
done

if [[ -f "$root/ai.sh" ]]; then
  launcher=(./ai.sh)
else
  # No wrapper: claude direct, with the flags ai.sh would have added. mise is
  # already active in an interactive shell, which is the other half of its job.
  if ! command -v claude >/dev/null 2>&1; then
    echo "island-ai: no ai.sh above $PWD, and no claude on PATH" >&2
    exit 1
  fi
  root=$(git -C "$PWD" rev-parse --show-toplevel 2>/dev/null || echo "$PWD")
  launcher=(claude --dangerously-skip-permissions)
  : "${AI_EFFORT=high}"
  [[ -n "$AI_EFFORT" ]] && launcher+=(--effort "$AI_EFFORT")
  echo "island-ai: no ai.sh — running claude in $root" >&2
fi

# Capture the session name: an explicit --name/-n if the caller passed one,
# otherwise the branch (or the directory) — injected as --name. It sets claude's
# terminal title and, below, herdr's agent-panel label.
args=("$@")
session_name=""
prev=""
for arg in "${args[@]}"; do
  case "$prev" in --name|-n) session_name="$arg" ;; esac
  case "$arg" in --name=*) session_name="${arg#--name=}" ;; esac
  prev="$arg"
done
if [[ -z "$session_name" ]]; then
  session_name=$(git -C "$root" symbolic-ref --quiet --short HEAD 2>/dev/null || true)
  [[ -n "$session_name" ]] || session_name=$(basename "$root")
  args=(--name "$session_name" "${args[@]}")
fi

if [[ -t 1 ]]; then
  color=$(island-worktree-color "$root" --bg 2>/dev/null || true)
  if [[ "$color" =~ ^#[0-9A-Fa-f]{6}$ ]]; then
    printf '\033]11;%s\033\\' "$color"
    [[ -n "${ISLAND_AI_KEEP_COLOR:-}" ]] || trap 'printf "\033]111\033\\"' EXIT
  fi
fi

# Under herdr, home this pane in its worktree's own space (create or reuse) before
# the agent starts, so one space == one worktree. The move reassigns the pane id, so
# use the id island-space hands back for the rename below.
pane="${HERDR_PANE_ID:-}"
if [[ -n "${HERDR_ENV:-}" && -n "$pane" ]] && command -v island-space >/dev/null 2>&1; then
  moved=$(island-space "$root" --focus 2>/dev/null || true)
  [[ -n "$moved" ]] && pane="$moved"
fi

# The agent panel labels every agent by its kind ("claude") — it does not read
# claude's --name (that only sets the terminal title). Push the session name in as
# herdr's agent name so the panel reads the branch too. The pane becomes a rename
# target only once herdr has detected the agent, so retry in the background;
# `trap - EXIT` stops this subshell from firing the color reset above when it finishes.
if [[ -n "${HERDR_ENV:-}" && -n "$pane" && -n "$session_name" ]] \
   && command -v herdr >/dev/null 2>&1; then
  (
    trap - EXIT
    for _ in $(seq 1 30); do
      herdr agent rename "$pane" "$session_name" >/dev/null 2>&1 && break
      sleep 1
    done
  ) &
fi

# A session started from inside another Claude Code session is not saved, and an
# unsaved session can never be --resume'd.
unset CLAUDE_CODE_CHILD_SESSION

cd "$root"
"${launcher[@]}" "${args[@]}"
