#!/bin/bash
# island:summary=Switch the island-mac theme (ghostty, tmux, neovim, wallpaper).
# island:args=<theme-name> [--dark]

set -eEo pipefail

ISLAND_PATH="${ISLAND_PATH:-$HOME/.local/share/island-mac}"
STATE_DIR="$HOME/.local/state/island-mac"

if [[ -z "${1:-}" ]]; then
  echo "Available themes:"
  for dir in "$ISLAND_PATH"/themes/*/; do
    [[ -d "$dir" ]] && echo "  $(basename "$dir")"
  done
  echo
  echo "Usage: island-theme-set <theme-name> [--dark]"
  exit 1
fi

THEME="$1"
THEME_DIR="$ISLAND_PATH/themes/$THEME"
if [[ ! -d "$THEME_DIR" ]]; then
  echo "Error: theme '$THEME' not found in $ISLAND_PATH/themes/" >&2
  exit 1
fi

echo "Switching to theme: $THEME"

# Load color definitions
# shellcheck source=/dev/null
source "$THEME_DIR/colors.sh"

# Optional pure-black background override
if [[ "${2:-}" == "--dark" ]]; then
  THEME_BG="#000000"
  THEME_BG_ALT="#0a0a0a"
  THEME_BG_HIGHLIGHT="#141414"
  THEME_BASE="#000000"
  THEME_SURFACE="#0a0a0a"
  THEME_OVERLAY="#141414"
  THEME_NAME="${THEME_NAME} (dark)"
fi

# Build the {{VAR}} -> value sed program from every THEME_* variable in scope.
build_sed() {
  local sed_args=""
  local var val
  for var in $(compgen -v | grep '^THEME_'); do
    val="${!var}"
    # Escape sed replacement specials: backslash first, then & and the | delimiter.
    val="${val//\\/\\\\}"
    val="${val//&/\\&}"
    val="${val//|/\\|}"
    sed_args+="s|{{${var}}}|${val}|g;"
  done
  echo "$sed_args"
}
SED_CMD=$(build_sed)

process_template() {
  local tpl="$1" dest="$2"
  mkdir -p "$(dirname "$dest")"
  sed "$SED_CMD" "$tpl" > "$dest"
}

# "#rrggbb" -> "r g b" as 0..1 floats (C locale so decimals use '.').
_hex_components() {
  local hex="${1#\#}"
  local r=$((16#${hex:0:2})) g=$((16#${hex:2:2})) b=$((16#${hex:4:2}))
  LC_ALL=C awk -v r="$r" -v g="$g" -v b="$b" \
    'BEGIN{printf "%.17g %.17g %.17g", r/255, g/255, b/255}'
}

# Generate an iTerm2 "island-mac" dynamic profile from the same Ghostty
# bundled theme (THEME_GHOSTTY) that Ghostty renders, so both terminals match.
# iTerm2 watches DynamicProfiles/ and hot-reloads. No-op without iTerm2 or jq.
render_iterm2() {
  local support="$HOME/Library/Application Support/iTerm2"
  [[ -d "$support" || -d "/Applications/iTerm.app" ]] || return 0
  command -v jq >/dev/null 2>&1 || { echo "  iTerm2: jq missing, skipping"; return 0; }

  local gfile="/Applications/Ghostty.app/Contents/Resources/ghostty/themes/$THEME_GHOSTTY"
  if [[ ! -f "$gfile" ]]; then
    echo "  iTerm2: ghostty theme '$THEME_GHOSTTY' not found, skipping"
    return 0
  fi

  local -a ansi=()
  local bg fg cur curtext selbg selfg line v
  while IFS= read -r line; do
    case "$line" in
      "palette = "*)              v="${line#*= }"; v="${v// /}"
                                  ansi[${v%%=*}]="${v#*=}" ;;
      "background = "*)           v="${line#*= }"; bg="${v// /}" ;;
      "foreground = "*)           v="${line#*= }"; fg="${v// /}" ;;
      "cursor-color = "*)         v="${line#*= }"; cur="${v// /}" ;;
      "cursor-text = "*)          v="${line#*= }"; curtext="${v// /}" ;;
      "selection-background = "*) v="${line#*= }"; selbg="${v// /}" ;;
      "selection-foreground = "*) v="${line#*= }"; selfg="${v// /}" ;;
    esac
  done < "$gfile"

  emit_pairs() {
    local i
    for ((i=0; i<=15; i++)); do
      [[ -n "${ansi[$i]:-}" ]] && echo "Ansi $i Color|${ansi[$i]}"
    done
    [[ -n "${bg:-}" ]]      && echo "Background Color|$bg"
    [[ -n "${fg:-}" ]]      && { echo "Foreground Color|$fg"; echo "Bold Color|$fg"; }
    [[ -n "${cur:-}" ]]     && echo "Cursor Color|$cur"
    [[ -n "${curtext:-}" ]] && echo "Cursor Text Color|$curtext"
    [[ -n "${selbg:-}" ]]   && echo "Selection Color|$selbg"
    [[ -n "${selfg:-}" ]]   && echo "Selected Text Color|$selfg"
  }

  local colors
  colors=$(emit_pairs | while IFS='|' read -r key hex; do
    [[ -n "$key" ]] || continue
    # shellcheck disable=SC2046
    set -- $(_hex_components "$hex")
    jq -n --arg k "$key" --argjson r "$1" --argjson g "$2" --argjson b "$3" \
      '{($k):{"Color Space":"sRGB","Red Component":$r,"Green Component":$g,"Blue Component":$b,"Alpha Component":1}}'
  done | jq -s 'add')

  # --- Typography tunables (island-mac's iTerm2 profile) ---------------------
  # Font mirrors Ghostty's (JetBrainsMono Nerd Font), one point larger.
  # Mono ("NFM") variant so Nerd-Font icons stay single-cell in iTerm2.
  # Vertical Spacing 1.0 = default line height; >1 adds space between rows.
  local font_ps="JetBrainsMonoNFM-Regular"
  local vspace="1.15" hspace="1.0"
  local gsize
  gsize=$(grep -E '^font-size[[:space:]]*=' "$HOME/.config/ghostty/config" 2>/dev/null \
    | head -1 | sed 's/.*=[[:space:]]*//')
  [[ "$gsize" =~ ^[0-9]+$ ]] || gsize=16
  local fontsize=$((gsize + 1))
  # ---------------------------------------------------------------------------

  mkdir -p "$support/DynamicProfiles"
  jq -n --arg name "island-mac" --arg guid "island-mac-theme" \
    --arg font "$font_ps $fontsize" \
    --argjson vspace "$vspace" --argjson hspace "$hspace" \
    --argjson colors "$colors" \
    '{Profiles:[ ($colors + {
        "Name":$name, "Guid":$guid, "Custom Command":"No",
        "Normal Font":$font, "Use Non-ASCII Font":false,
        "Vertical Spacing":$vspace, "Horizontal Spacing":$hspace,
        "ASCII Anti Aliased":true, "Non-ASCII Anti Aliased":true
     }) ]}' \
    > "$support/DynamicProfiles/island-mac.json"
  echo "  iTerm2 profile: island-mac ($THEME_NAME, ${font_ps##*-} ${fontsize}pt, line ${vspace})"
}

echo "  Processing templates..."
process_template "$ISLAND_PATH/templates/ghostty-config.tpl"  "$HOME/.config/ghostty/config"
process_template "$ISLAND_PATH/templates/tmux-theme.conf.tpl" "$HOME/.config/tmux/theme.conf"
process_template "$ISLAND_PATH/templates/starship.toml.tpl"   "$HOME/.config/starship.toml"

# Neovim — rewrite the active colorscheme plugin
NVIM_THEME="$HOME/.config/nvim/lua/plugins/island-theme.lua"
if [[ -d "$HOME/.config/nvim/lua/plugins" ]]; then
  cat > "$NVIM_THEME" <<NVEOF
-- Active colorscheme (managed by island-theme-set, do not edit manually)
-- Set via LazyVim's colorscheme opt so LazyVim applies it at the right time
-- (a plain vim.cmd("colorscheme ...") loses the race with LazyVim's default).
return {
  { "$THEME_NVIM_PLUGIN", lazy = false, priority = 1000 },
  { "LazyVim/LazyVim", opts = { colorscheme = "$THEME_NVIM_COLORSCHEME" } },
}
NVEOF
fi

# Save current theme name
mkdir -p "$STATE_DIR"
if [[ "${2:-}" == "--dark" ]]; then
  echo "${THEME}:dark" > "$STATE_DIR/current-theme"
else
  echo "$THEME" > "$STATE_DIR/current-theme"
fi

# Apply to running components
echo "  Reloading components..."
# tmux: reload theme into any running server
tmux source-file "$HOME/.config/tmux/theme.conf" 2>/dev/null || true

# herdr: point its [theme].name at the matching built-in theme and hot-reload.
# Only the name line under [theme] is rewritten — the rest of the user's
# herdr config (keybindings, etc.) is left untouched.
HERDR_CFG="$HOME/.config/herdr/config.toml"
if [[ -n "${THEME_HERDR:-}" && -f "$HERDR_CFG" ]]; then
  tmp_herdr=$(mktemp)
  awk -v newname="$THEME_HERDR" '
    /^\[/ { in_theme = ($0 == "[theme]") }
    in_theme && /^[ \t]*name[ \t]*=/ { print "name = \"" newname "\""; next }
    { print }
  ' "$HERDR_CFG" > "$tmp_herdr" && mv "$tmp_herdr" "$HERDR_CFG" || true
  rm -f "$tmp_herdr" 2>/dev/null || true
  command -v herdr >/dev/null 2>&1 && herdr server reload-config >/dev/null 2>&1 || true
  echo "  herdr theme: $THEME_HERDR"
fi

# iTerm2: regenerate the island-mac dynamic profile (auto-reloaded by iTerm2).
render_iterm2

# Wallpaper: use the theme's first wallpaper if present
THEME_WALLS="$THEME_DIR/wallpapers"
if [[ -d "$THEME_WALLS" ]]; then
  first_wall=$(find "$THEME_WALLS" -maxdepth 1 -type f \
    \( -iname '*.jpg' -o -iname '*.jpeg' -o -iname '*.png' -o -iname '*.webp' \) \
    2>/dev/null | sort | head -1)
  if [[ -n "$first_wall" ]]; then
    "$ISLAND_PATH/bin/island-wallpaper-set" "$first_wall" >/dev/null 2>&1 \
      && echo "  Wallpaper: $(basename "$first_wall")"
  fi
fi

echo "  Done. Reload Ghostty with Cmd+Shift+, to pick up the new theme."
