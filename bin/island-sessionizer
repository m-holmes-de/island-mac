#!/bin/bash
# island:summary=herdr sessionizer (gum TUI) — fuzzy-pick a project, jump to its workspace or create one (optionally launching Claude via island-ai).
# island:args=[none]
#
# Bound to Ctrl+F (a tmux-sessionizer for herdr). Shows a fuzzy list of live herdr
# workspaces (with agent status) plus every project under ~/Projects with no session
# yet. Pick one: an existing session gets focused; for a fresh project you choose
# whether to launch the ai wrapper, and whether it opens in a new short-named workspace
# (via island-space-name) or a grid-tiled pane in the CURRENT workspace (aim for a 2x2
# grid per tab, overflowing to a new tab once a tab is full).

set -eEo pipefail
# ~/.local/bin FIRST: the running herdr server lives there, and a Homebrew herdr of
# a different version would fail every call with protocol_mismatch. Homebrew (gum/jq)
# comes after — nothing island needs is shadowed by that order.
export PATH="$HOME/.local/bin:$HOME/.local/share/island-mac/bin:/opt/homebrew/bin:$HOME/.cargo/bin:$PATH"

for dep in gum herdr jq; do
  command -v "$dep" >/dev/null 2>&1 || { echo "island-sessionizer: $dep not found" >&2; exit 1; }
done

# Optional breadcrumb for debugging a launch: touch ~/.island-sessionizer-debug.
_dbg() { [[ -f "$HOME/.island-sessionizer-debug" ]] && printf '%s %s\n' "$(date '+%T')" "$*" >> /tmp/island-sessionizer.log || true; }
_dbg "=== invoked (HERDR_ENV=${HERDR_ENV:-unset} pane=${HERDR_PANE_ID:-unset}) ==="

# Place a new pane in workspace $1 (cwd $2), tiling toward a 2x2 grid per tab: grow
# the first tab that still has room (<4 panes), else open a fresh tab. Echoes the new
# pane_id (empty on failure). Pane-id order is read as creation/spatial order, which
# is how splits below build the grid — good enough for grids this tool makes; a tab
# the user has hand-rearranged may tile unevenly, never wrongly.
grid_place() {
  local wid="$1" cwd="$2" tabid panes tgt dir_split out
  tabid=$(herdr tab list --workspace "$wid" 2>/dev/null \
    | jq -r --arg w "$wid" \
        '[.result.tabs[]? | select(.workspace_id==$w and .pane_count<4)] | sort_by(.number) | .[0].tab_id // empty' \
        2>/dev/null || true)
  if [[ -z "$tabid" ]]; then
    # Every tab is already a full 2x2 — overflow into a fresh tab, agent in its root.
    out=$(herdr tab create --workspace "$wid" --cwd "$cwd" --focus 2>/dev/null || true)
    printf '%s' "$out" | jq -r '.result.root_pane.pane_id // empty' 2>/dev/null || true
    return 0
  fi
  # Panes of that tab in creation order; the split target + direction grow a clean 2x2:
  #   1 pane  -> split it right        (two columns)
  #   2 panes -> split the first down  (left column -> two rows)
  #   3 panes -> split the second down (right column -> two rows, grid complete)
  panes=$(herdr pane list --workspace "$wid" 2>/dev/null \
    | jq -r --arg t "$tabid" \
        '[.result.panes[]? | select(.tab_id==$t) | .pane_id] | sort_by(sub("^.*:p";"")|tonumber) | .[]' \
        2>/dev/null || true)
  local p=()
  while IFS= read -r _x; do [[ -n "$_x" ]] && p+=("$_x"); done <<< "$panes"
  case "${#p[@]}" in
    0) return 1 ;;
    1) tgt="${p[0]}"; dir_split=right ;;
    2) tgt="${p[0]}"; dir_split=down ;;
    *) tgt="${p[1]:-${p[0]}}"; dir_split=down ;;
  esac
  out=$(herdr pane split "$tgt" --direction "$dir_split" --cwd "$cwd" --focus 2>/dev/null || true)
  printf '%s' "$out" | jq -r '.result.pane.pane_id // empty' 2>/dev/null || true
}

projects="$HOME/Projects"
state_dir="$HOME/.local/state/island-mac/space-names"

ws_json=$(herdr workspace list 2>/dev/null || echo '{}')
ag_json=$(herdr agent list 2>/dev/null || echo '{}')
open_cwds=$(printf '%s' "$ag_json" | jq -r '.result.agents[]?.cwd' 2>/dev/null || true)

displays=(); actions=()

# 1) Live herdr workspaces first, glyphed by the worst status of their agents.
while IFS=$'\t' read -r wid label; do
  [[ -n "$wid" ]] || continue
  st=$(printf '%s' "$ag_json" | jq -r --arg w "$wid" \
        '[.result.agents[]? | select(.workspace_id==$w) | .agent_status] | join(",")' 2>/dev/null || true)
  case "$st" in
    *blocked*) g="⏸" ;;
    *working*) g="⚙" ;;
    *idle*)    g="✓" ;;
    *)         g="·" ;;
  esac
  displays+=("$g  $label   ⟨session⟩")
  actions+=("ws:$wid")
done < <(printf '%s' "$ws_json" | jq -r '.result.workspaces[]? | [.workspace_id, .label] | @tsv' 2>/dev/null || true)

# 2) Projects under ~/Projects that have no running agent yet. Use the cached short
# name if there is one (cheap) — never call the AI namer here, or opening the picker
# would fork claude for every uncached dir.
for d in "$projects"/*/; do
  d="${d%/}"
  [[ -d "$d" ]] || continue
  printf '%s\n' "$open_cwds" | grep -qxF "$d" && continue
  key=$(printf '%s' "$d" | tr -c '[:alnum:]-' '_')
  if [[ -s "$state_dir/$key" ]]; then name=$(head -n1 "$state_dir/$key"); else name=$(basename "$d"); fi
  branch=$(git -C "$d" symbolic-ref --quiet --short HEAD 2>/dev/null || true)
  displays+=("○  $name   ·  ${branch:-$(basename "$d")}")
  actions+=("dir:$d")
done

(( ${#displays[@]} )) || { echo "island-sessionizer: nothing to show" >&2; exit 0; }

sel=$(printf '%s\n' "${displays[@]}" | gum filter --height 20 --prompt "session ❯ " --placeholder "type to filter…" || true)
[[ -n "$sel" ]] || exit 0

action=""
for i in "${!displays[@]}"; do
  [[ "${displays[$i]}" == "$sel" ]] && { action="${actions[$i]}"; break; }
done
_dbg "selected sel='$sel' action='$action'"
[[ -n "$action" ]] || exit 0

case "$action" in
  ws:*)
    herdr workspace focus "${action#ws:}" >/dev/null 2>&1
    ;;
  dir:*)
    dir="${action#dir:}"
    # Ask now, while this pane still has focus (gum needs the keystrokes).
    launch=no
    gum confirm "Launch a Claude agent in this workspace?" && launch=yes

    # Where should it land? A fresh workspace (the original behaviour), or a pane in
    # the CURRENT workspace tiled toward a 2x2 grid. Only offer "current" when we have
    # a herdr pane to anchor the split to — always true under Ctrl+F, false if someone
    # runs island-sessionizer from a plain shell.
    place=new
    if [[ -n "${HERDR_PANE_ID:-}" ]]; then
      choice=$(printf 'New workspace\nCurrent workspace (tile)\n' \
        | gum choose --header "Where?" || true)
      [[ "$choice" == Current* ]] && place=current
    fi
    _dbg "dir='$dir' launch=$launch place=$place"

    # Tile into the current workspace: no new workspace, no island-space-name label
    # (island-ai names the agent off the branch itself). Fall through to a new
    # workspace if tiling could not place a pane.
    if [[ "$place" == "current" ]]; then
      newpane=$(grid_place "${HERDR_PANE_ID%%:*}" "$dir")
      _dbg "grid_place -> '$newpane'"
      if [[ -n "$newpane" ]]; then
        [[ "$launch" == "yes" ]] && herdr pane run "$newpane" "island-ai" >/dev/null 2>&1 || true
        _dbg "done: tiled pane $newpane, launched=$launch"
        exit 0
      fi
      gum style --foreground 3 "island-sessionizer: could not tile a pane — opening a new workspace instead"
    fi

    label=$(island-space-name "$dir")
    _dbg "label='$label'"
    # Create UNFOCUSED then focus explicitly, retrying once — creating with --focus
    # from inside the calling pane, or under load, can return without the new ids.
    wid=""; pane=""
    for _try in 1 2 3; do
      out=$(herdr workspace create --label "$label" --cwd "$dir" --no-focus 2>/dev/null || true)
      wid=$(printf '%s' "$out" | jq -r '.result.workspace.workspace_id // empty' 2>/dev/null || true)
      pane=$(printf '%s' "$out" | jq -r '.result.root_pane.pane_id // empty' 2>/dev/null || true)
      _dbg "create try=$_try outlen=${#out} wid='$wid' pane='$pane'"
      [[ -n "$wid" ]] && break
      sleep 1
    done
    if [[ -z "$wid" ]]; then
      gum style --foreground 1 "island-sessionizer: could not create workspace '$label'"
      exit 1
    fi
    [[ "$launch" == "yes" && -n "$pane" ]] && herdr pane run "$pane" "island-ai" >/dev/null 2>&1 || true
    herdr workspace focus "$wid" >/dev/null 2>&1 || true
    _dbg "done: focused $wid, launched=$launch"
    ;;
esac
